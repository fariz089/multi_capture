{
  "manifest_version": 3,
  "name": "Multi-Capture Cookie Bridge",
  "version": "1.1.0",
  "description": "Extract cookies + localStorage dari Facebook/Instagram/TikTok/Twitter/Threads dan push ke multi_capture local server. Pakai Chrome real (gak ke-detect anti-bot).",

  "permissions": [
    "cookies",
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],

  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.threads.net/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Multi-Capture: extract session ke local server",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
